# ── Azure ────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_SUBSCRIPTION_ID=your-subscription-id

# ── Key Vault ────────────────────────────────────────
AZURE_KEY_VAULT_URL=https://your-kv.vault.azure.net/

# ── ADLS Gen2 ────────────────────────────────────────
ADLS_ACCOUNT_NAME=your-storage-account
ADLS_CONTAINER_NAME=coldshare-lake

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=coldshare
POSTGRES_USER=coldshare_user
POSTGRES_PASSWORD=your-password

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Azure Event Hubs 사용 시 아래로 교체:
# KAFKA_BOOTSTRAP_SERVERS=your-eventhub.servicebus.windows.net:9093
# KAFKA_SASL_USERNAME=$ConnectionString
# KAFKA_SASL_PASSWORD=your-connection-string

# ── Azure AI Foundry ─────────────────────────────────
# datacops (Llama-4-Maverick, gpt-4-1-mini)
AZURE_AI_API_KEY=your-datacops-api-key
# team4-foundry-eastus (Phi-4-mini-instruct, Phi-4, Llama-3.3-70B)
AZURE_AI_API_KEY_TEAM4=your-team4-api-key

# ── 외부 API ─────────────────────────────────────────
AT_API_KEY=your-at-kamis-api-key       # aT 농산물유통정보 KAMIS
KMA_API_KEY=your-kma-api-key          # 기상청 단기예보

# ── 환경 ─────────────────────────────────────────────
ENV=local   # local | dev | prod
